text = "How cows gain happiness"
horizontal_alignment = 1

[node name="Label7" type="Label" parent="page_stocker/cow/Control/VBoxContainer"]
layout_mode = 2
text = "- they gained happiness if they are in scatter mode"
horizontal_alignment = 1

[node name="Label8" type="Label" parent="page_stocker/cow/Control/VBoxContainer"]
layout_mode = 2
text = "- but if you stay too long in the same area, they start losing "
horizontal_alignment = 1

[node name="Label9" type="Label" parent="page_stocker/cow/Control/VBoxContainer"]
