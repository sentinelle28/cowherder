text = "Happiness and Feedness"
horizontal_alignment = 1

[node name="Label3" type="Label" parent="page_stocker/cow/Control/VBoxContainer"]
layout_mode = 2
text = "Cows gain naturaly feedness if there are in a scatter mode"
horizontal_alignment = 1

[node name="Label4" type="Label" parent="page_stocker/cow/Control/VBoxContainer"]
layout_mode = 2
text = "For happiness it is a bit more difficult"
horizontal_alignment = 1

[node name="Label5" type="Label" parent="page_stocker/cow/Control/VBoxContainer"]
