[node name="Label" type="Label" parent="page_stocker/third_page/Control/VBoxContainer"]
layout_mode = 2
text = "	Cows have two important stats:"
horizontal_alignment = 1

[node name="Label2" type="Label" parent="page_stocker/third_page/Control/VBoxContainer"]
layout_mode = 2
text = "Happiness and Feedness"
horizontal_alignment = 1

[node name="Label3" type="Label" parent="page_stocker/third_page/Control/VBoxContainer"]
layout_mode = 2
text = "Cows gain naturaly feedness if there are in a scatter mode"
horizontal_alignment = 1

[node name="Label4" type="Label" parent="page_stocker/third_page/Control/VBoxContainer"]
layout_mode = 2
text = "For happiness it is a bit more difficult"
horizontal_alignment = 1

[node name="Label5" type="Label" parent="page_stocker/third_page/Control/VBoxContainer"]
layout_mode = 2
text = "How cows gain happiness"
horizontal_alignment = 1

[node name="Label7" type="Label" parent="page_stocker/third_page/Control/VBoxContainer"]
layout_mode = 2
text = "- they gained happiness if they are in scatter mode"
horizontal_alignment = 1

[node name="Label8" type="Label" parent="page_stocker/third_page/Control/VBoxContainer"]
layout_mode = 2
text = "- but if you stay too long in the same area, they start losing "
horizontal_alignment = 1

[node name="Label9" type="Label" parent="page_stocker/third_page/Control/VBoxContainer"]
layout_mode = 2
text = "happiness"
horizontal_alignment = 1

