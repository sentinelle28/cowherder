; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Cowherder"
run/main_scene="res://scene/scene_2d/main_menu/main_menu.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

InspectCows="*res://autolaud/inspectcows/inspect_cows.tscn"
Daycycle="*res://autolaud/daycyle/daycycle.tscn"
Inventory="*res://autolaud/inventory/inventory.gd"
ToolInventory="*res://autolaud/tool_inventory/tool_inventory.tscn"
Handbook="*res://autolaud/handbook/handbook.tscn"
SellInventory="*res://autolaud/shop_related/sell_inventory.tscn"
ShopOffer="*res://autolaud/shop_related/Shop_offer.gd"
MainMusic="*res://autolaud/main_music/main_music.tscn"
BuyingMenu="*res://autolaud/shop_related/buying_menu.tscn"
GlobaleEscape="*res://autolaud/global_escape/globale_escape.tscn"
SceneTransition="*res://autolaud/scene_transition/scene_transition.tscn"

[display]

window/stretch/mode="viewport"
window/stretch/aspect="expand"

[input]

escape={
